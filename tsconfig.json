{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/components/appointments": [
        "./components/features/appointments"
      ],
      "@/components/appointments/*": [
        "./components/features/appointments/*"
      ],
      "@/components/auth": [
        "./components/features/auth"
      ],
      "@/components/auth/*": [
        "./components/features/auth/*"
      ],
      "@/components/campaign": [
        "./components/features/campaign"
      ],
      "@/components/campaign/*": [
        "./components/features/campaign/*"
      ],
      "@/components/dashboard": [
        "./components/features/dashboard"
      ],
      "@/components/dashboard/*": [
        "./components/features/dashboard/*"
      ],
      "@/components/doctors": [
        "./components/features/doctors"
      ],
      "@/components/doctors/*": [
        "./components/features/doctors/*"
      ],
      "@/components/odontogram": [
        "./components/features/odontogram"
      ],
      "@/components/odontogram/*": [
        "./components/features/odontogram/*"
      ],
      "@/components/patients": [
        "./components/features/patients"
      ],
      "@/components/patients/*": [
        "./components/features/patients/*"
      ],
      "@/components/roles": [
        "./components/features/roles"
      ],
      "@/components/roles/*": [
        "./components/features/roles/*"
      ],
      "@/components/settings": [
        "./components/features/settings"
      ],
      "@/components/settings/*": [
        "./components/features/settings/*"
      ],
      "@/components/template": [
        "./components/features/template"
      ],
      "@/components/template/*": [
        "./components/features/template/*"
      ],
      "@/components/auto-logout-warning-modal": [
        "./components/app/auto-logout-warning-modal"
      ],
      "@/components/global-alert-dialog": [
        "./components/app/global-alert-dialog"
      ],
      "@/components/global-loading-spinner": [
        "./components/app/global-loading-spinner"
      ],
      "@/components/interceptors-context-initializer": [
        "./components/app/interceptors-context-initializer"
      ],
      "@/components/interceptors-initializer": [
        "./components/app/interceptors-initializer"
      ],
      "@/components/theme-provider": [
        "./components/app/theme-provider"
      ],
      "@/components/ui/alert-dialog": [
        "./components/ui/index"
      ],
      "@/components/ui/badge": [
        "./components/ui/index"
      ],
      "@/components/ui/button": [
        "./components/ui/index"
      ],
      "@/components/ui/card": [
        "./components/ui/index"
      ],
      "@/components/ui/checkbox": [
        "./components/ui/index"
      ],
      "@/components/ui/dialog": [
        "./components/ui/index"
      ],
      "@/components/ui/dropdown-menu": [
        "./components/ui/index"
      ],
      "@/components/ui/input": [
        "./components/ui/index"
      ],
      "@/components/ui/label": [
        "./components/ui/index"
      ],
      "@/components/ui/scroll-area": [
        "./components/ui/index"
      ],
      "@/components/ui/select": [
        "./components/ui/index"
      ],
      "@/components/ui/sheet": [
        "./components/ui/index"
      ],
      "@/components/ui/slider": [
        "./components/ui/index"
      ],
      "@/components/ui/tabs": [
        "./components/ui/index"
      ],
      "@/components/ui/textarea": [
        "./components/ui/index"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-build/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}

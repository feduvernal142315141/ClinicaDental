# ─────────────────────────────────────────────────────────────────────────────
# Clinic Flow 360 — front-clinic · variables de entorno
# Copia este archivo a `.env.local` y rellena los valores.
#   cp .env.example .env.local
# Todas las vars van con prefijo NEXT_PUBLIC_ → se inyectan EN BUILD y quedan
# expuestas al navegador. No pongas secretos aquí (no hacen falta).
# ─────────────────────────────────────────────────────────────────────────────

# API (backend-clinic, Spring Boot). Requerida.
NEXT_PUBLIC_API_URL=http://localhost:8080/

# Debug de auth (opcional): loguea el flujo OTP/JWT en consola.
NEXT_PUBLIC_AUTH_DEBUG=false

# ── Subida del logo de la clínica ────────────────────────────────────────────
# Driver de subida de imágenes. Opcional: si se omite, se resuelve solo 
#   → "local" en dev, "cloudinary" en producción (si está configurado).
#   "local"      → POST a /api/upload (guarda en public/uploads). Solo dev.
#   "cloudinary" → unsigned upload directo desde el navegador. Para prod.
# Deja "local" en desarrollo para NO depender de Cloudinary.
NEXT_PUBLIC_UPLOAD_DRIVER=local

# Cloudinary — SOLO necesario en producción (o si fuerzas el driver cloudinary).
#   1. Cloud name de tu cuenta Cloudinary.
#   2. Un Upload preset en modo *Unsigned* (Settings → Upload → Upload presets).
#      ⚠️ Si el preset es *Signed*, el navegador recibe 401 Unauthorized.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=tu-upload-preset-unsigned

# ── Supabase (LEGACY, en retirada hacia JWT-only) ────────────────────────────
# Solo si tocas código legacy que aún lee de Supabase. No extender.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# ─────────────────────────────────────────────────────────────────────────────
# Clinic Flow 360 — front-clinic · variables de entorno
# Copia este archivo a `.env.local` y rellena los valores.
#   cp .env.example .env.local
# Todas las vars van con prefijo NEXT_PUBLIC_ → se inyectan EN BUILD y quedan
# expuestas al navegador. No pongas secretos aquí (no hacen falta).
# ─────────────────────────────────────────────────────────────────────────────

# API (backend-clinic, Spring Boot). Requerida.
NEXT_PUBLIC_API_URL=http://localhost:8080/

# Debug de auth (opcional): loguea el flujo OTP/JWT en consola.
NEXT_PUBLIC_AUTH_DEBUG=false

# ── Subida del logo de la clínica ────────────────────────────────────────────
# El logo se sube al BACKEND (POST /api/v1/cloudinary/upload, autenticado),
# que reenvía a Cloudinary de forma firmada y devuelve la secureUrl. No hay
# variables de entorno de Cloudinary que configurar en el frontend.

# ── Supabase (LEGACY, en retirada hacia JWT-only) ────────────────────────────
# Solo si tocas código legacy que aún lee de Supabase. No extender.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
